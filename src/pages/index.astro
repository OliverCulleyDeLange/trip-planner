---
import TripPlanner from '../components/TripPlanner.astro';
const legacyTripId = Astro.url.searchParams.get('trip');
if (legacyTripId) {
  const normalizedTripId = legacyTripId;
  return Astro.redirect(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}trips/${encodeURIComponent(normalizedTripId)}`, 308);
}
---

<TripPlanner page="home" />
