{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "trip-scheduler",
	"account_id": "e07409ca802c44c917ffee7a4a97af1b",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"assets": {
		"binding": "ASSETS",
		"directory": "dist"
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "oliverdelange.co.uk/trip-planner*",
			"zone_name": "oliverdelange.co.uk"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "trip-scheduler-production",
			"database_id": "fc577354-8036-4bad-a2a1-4c9a8791d5fc",
			"migrations_dir": "migrations"
		}
	]
}
